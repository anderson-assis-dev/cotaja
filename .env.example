# Cotaja React Native - Environment Variables
# Copy this file to .env and fill in your values

# API Base URL (without trailing slash)
# Examples:
#   - Local development: http://localhost:3000/api
#   - Cloud server: https://api.cotaja.com/api
API_BASE_URL=http://localhost:3000/api

# Server Base URL (for assets like images)
# Examples:
#   - Local development: http://localhost:3000
#   - Cloud server: https://api.cotaja.com
SERVER_BASE_URL=http://localhost:3000

# Stripe Publishable Key (replace with your actual Stripe publishable key)
# Development key (replace with your actual test key)
STRIPE_PUBLISHABLE_KEY=pk_test_51M9sXoH8qj2n1aXy7v5z6u8w9x0y1z2a3b4c5.....4m5n6o7p8q9r0s1t2u3v4w5x6y7z8